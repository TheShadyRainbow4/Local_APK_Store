<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#729619"/>
                    <corners android:radius="6dp"/>
                    <stroke android:width="1dp" android:color="#556b2f"/>
                    <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="6dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Shadow/chin -->
            <item android:top="2dp">
                <shape>
                    <solid android:color="#556b2f"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <!-- Button face -->
            <item android:bottom="3dp">
                <shape>
                    <gradient android:startColor="#A4C639" android:endColor="#82A629" android:angle="270" />
                    <corners android:radius="6dp"/>
                    <stroke android:width="1dp" android:color="#729619"/>
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="10dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
